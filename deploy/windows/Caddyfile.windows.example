# API rate/concurrency policies live in the Control API; Caddy enforces the
# coarse public request-body ceiling before proxying uploads or JSON writes.
(xiaolou_auth_body_limit) {
	request_body {
		max_size {$XIAOLOU_AUTH_BODY_MAX_SIZE:64KB}
	}
}

(xiaolou_json_body_limit) {
	request_body {
		max_size {$XIAOLOU_API_JSON_BODY_MAX_SIZE:2MB}
	}
}

(xiaolou_media_upload_body_limit) {
	request_body {
		max_size {$XIAOLOU_MEDIA_UPLOAD_BODY_MAX_SIZE:256MB}
	}
}

www.example.com {
	root * D:/code/XiaoLouAI/.runtime/app/XIAOLOU-main/dist

	handle /api/internal/* {
		respond 404
	}

	handle /api/schema* {
		respond 404
	}

	handle /api/providers/health* {
		respond 404
	}

	handle /metrics {
		respond 404
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:4100
	}

	handle /livez {
		reverse_proxy 127.0.0.1:4100
	}

	handle /readyz {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/windows-native/status {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/capabilities {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/accounts/ensure {
		import xiaolou_auth_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/auth* {
		import xiaolou_auth_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/me {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/organizations* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/api-center* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/admin* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/enterprise-applications* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/playground* {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/toolbox* {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/jobs* {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/wallet {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/wallet/usage-stats {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/wallets {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/wallets/* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/payments/callbacks/* {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/media/upload-begin {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/media/upload-complete {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/media/move-temp-to-permanent {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/media/signed-read-url {
		import xiaolou_json_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/media/object-content/* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/media/object-upload/* {
		import xiaolou_media_upload_body_limit
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/projects* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/canvas-projects* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/agent-canvas/projects* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/create/images* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/create/videos* {
		reverse_proxy 127.0.0.1:4100
	}

	handle /api/* {
		respond 404
	}

	# Vite asset filenames are content-hashed. Cache only static assets here;
	# API/auth/payment/provider-health routes above must never inherit this.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
